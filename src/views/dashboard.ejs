<%- include('partials/header') %>
<%- include('partials/flash') %>
    <h1><%= title %></h1>
    <p>Welcome back, <%= user.name %>!</p>

    <!-- Conditionally render admin link based on role -->
    <% if (user && user.role_name === 'admin') { %>
        <div class="admin-section" style="margin-top: 20px; padding: 15px; border: 1px solid #ccc;">
            <h3>Admin Controls</h3>
            <ul>
                <li><a href="/users">View All Registered Users</a></li>
            </ul>
        </div>
    <% } %>

    <p style="margin-top: 20px;"><a href="/logout">Log Out</a></p>
<%- include('partials/footer') %>
