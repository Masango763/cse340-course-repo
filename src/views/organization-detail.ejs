<%- include('./partials/header') %>

<h2><%= organization.organization_name %></h2>
<p><strong>Description:</strong> <%= organization.description %></p>
<p><strong>Contact Email:</strong> <%= organization.email %></p>
<p><strong>Phone:</strong> <%= organization.phone %></p>

<section class="projects-list">
  <h3>Service Projects for <%= organization.organization_name %></h3>
  <% if (projects && projects.length > 0) { %>
    <ul>
      <% projects.forEach(project => { %>
        <li>
          <a href="/project/<%= project.project_id %>"><%= project.project_name %></a> 
          - <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %> (<%= project.location %>)
        </li>
      <% }); %>
    </ul>
  <% } else { %>
    <p>No service projects found for this organization.</p>
  <% } %>
</section>

<%- include('./partials/footer') %>
