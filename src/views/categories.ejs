<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
</head>
<body>
  <main>
    <h2>All Categories</h2>
    <% if (categories && categories.length > 0) { %>
      <ul>
        <% categories.forEach(category => { %>
          <li>
            <a href="/category/<%= category.category_id %>"><%= category.name %></a>
          </li>
        <% }); %>
      </ul>
    <% } else { %>
      <p>No categories found.</p>
    <% } %>
  </main>
</body>
</html>
