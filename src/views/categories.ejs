<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <ul class="category-list">
        <% categories.forEach((cat, index) => {
            const imageNumber = index + 1;
            const imageSrc = imageNumber <= 4 ? `/images/cat${imageNumber}.jpg` : '/images/placeholder.jpg';
        %>
            <li class="category-item">
                <a href="/category/<%= cat.category_id %>">
                    <img src="<%= imageSrc %>" alt="<%= cat.name %>" class="category-thumb" width="60" height="60" />
                    <span><%= cat.name %></span>
                </a>
            </li>
        <% }); %>
    </ul>
    <p><a href="/new-category">Add a New Category</a></p>
</main>
<%- include('partials/footer') %>
