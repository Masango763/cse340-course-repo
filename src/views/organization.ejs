<%- include('./partials/header') %>
<h2><%= organization.organization_name %></h2>
<p><strong>Location:</strong> <%= organization.location %></p>
<p><strong>Contact Email:</strong> <%= organization.contact_email %></p>
<p><%= organization.description %></p>
<h3>Service Projects</h3>
<% if (projects && projects.length > 0) { %>
  <ul>
    <% projects.forEach(project => { %>
      <li><a href="/project/<%= project.project_id %>"><%= project.project_name %></a> (<%= new Date(project.date).toLocaleDateString() %>)</li>
    <% }); %>
  </ul>
<% } else { %>
  <p>No projects listed for this organization.</p>
<% } %>
<%- include('./partials/footer') %>
