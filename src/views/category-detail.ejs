<%- include('./partials/header') %>

<h2>Category: <%= category.name %></h2>

<section class="projects-list">
  <h3>Service Projects in this Category</h3>
  <% if (projects && projects.length > 0) { %>
    <ul>
      <% projects.forEach(project => { %>
        <li>
          <a href="/project/<%= project.project_id %>"><%= project.project_name %></a> 
          - <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %> (<%= project.location %>)
        </li>
      <% }); %>
    </ul>
  <% } else { %>
    <p>No service projects found for this category.</p>
  <% } %>
</section>

<%- include('./partials/footer') %>
