<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Tech Charities</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/header') %>
    <main>
        <h2>Service Projects</h2>
        <% if (locals.projects && projects.length > 0) { %>
            <div class="category-grid">
                <% projects.forEach(project => { %>
                    <div class="card">
                        <h3><%= project.name %></h3>
                        <p><strong>Organization:</strong> <%= project.organization_name %></p>
                        <p><%= project.description %></p>
                        <p><small>Due: <%= project.due_date ? new Date(project.due_date).toLocaleDateString() : 'N/A' %></small></p>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <p>No projects found.</p>
        <% } %>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>
