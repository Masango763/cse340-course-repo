<%- include('./partials/header') %>

<h2>Upcoming Service Projects</h2>

<% if (projects && projects.length > 0) { %>
  <ul>
    <% projects.forEach(project => { %>
      <li>
        <strong><%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></strong>: 
        <a href="/project/<%= project.project_id %>"><%= project.title %></a> 
        (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)<br>
        <%= project.description %> — <%= project.location %>
      </li>
    <% }); %>
  </ul>
<% } else { %>
  <p>No upcoming service projects found.</p>
<% } %>

<%- include('./partials/footer') %>
