<%- include('partials/header') %>

<h2><%= title %></h2>

<% if (projects && projects.length > 0) { %>
  <ul class="project-list">
    <% projects.forEach(project => { %>
      <li class="project-item">
        <strong><%= new Date(project.date).toLocaleDateString() %>:</strong> 
        <a href="/project/<%= project.project_id %>"><%= project.title %></a> 
        (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)<br>
        <p><%= project.description %></p>
        <span>Location: <%= project.location %></span>
      </li>
    <% }); %>
  </ul>
<% } else { %>
  <p>No upcoming projects found.</p>
<% } %>

<%- include('partials/footer') %>
