<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <%- include('partials/header') %>

  <main>
    <h1>Service Projects</h1>

    <ul class="projects-list">
      <% if (projects && projects.length > 0) { %>
        <% projects.forEach(project => { %>
          <li>
            <strong><%= project.formattedDate %>:</strong> 
            <%= project.title %> 
            <em>(<%= project.organization_name %>)</em>
            <p><%= project.description %> — <span><%= project.location %></span></p>
          </li>
        <% }) %>
      <% } else { %>
        <p>No service projects found.</p>
      <% } %>
    </ul>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
