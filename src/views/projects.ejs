<%- include('./partials/header') %>
<%
  const projectImages = {
    // Add project-specific images here, e.g.:
    // 'Community Garden Build': '/images/project1.jpg',
  };
%>
<h2>Upcoming Service Projects</h2>
<% if (projects && projects.length > 0) { %>
  <ul style="list-style: none; padding: 0;">
    <% projects.forEach(project => { %>
      <li style="display: flex; align-items: center; margin-bottom: 15px; background: #f9f9f9; padding: 10px; border-radius: 6px;">
        <img src="<%= projectImages[project.title] || '/images/placeholder.jpg' %>" alt="<%= project.title %>" width="60" height="40" style="object-fit: cover; margin-right: 15px; border-radius: 4px;" />
        <div>
          <a href="/project/<%= project.project_id %>" style="font-size: 1.1em; font-weight: bold; text-decoration: none; color: #0066cc;"><%= project.title %></a>
          <p style="margin: 4px 0 0 0; color: #555; font-size: 0.9em;">
            Organization: <a href="/organization/<%= project.organization_id %>" style="color: #0066cc;"><%= project.organization_name %></a>
            &nbsp;|&nbsp; <%= new Date(project.date).toLocaleDateString() %>
          </p>
        </div>
      </li>
    <% }); %>
  </ul>
<% } else { %>
  <p>No upcoming service projects found.</p>
<% } %>
<%- include('./partials/footer') %>
