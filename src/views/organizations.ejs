<%- include('./partials/header') %>
<h2>Partner Organizations</h2>
<% if (organizations && organizations.length > 0) { %>
  <ul>
    <% organizations.forEach(org => { %>
      <li>
        <img src="/images/placeholder.jpg" alt="<%= org.organization_name %>" width="50" style="vertical-align: middle; margin-right: 10px;" />
        <a href="/organization/<%= org.organization_id %>"><%= org.organization_name %></a> - <%= org.location %>
      </li>
    <% }); %>
  </ul>
<% } else { %>
  <p>No organizations found.</p>
<% } %>
<%- include('./partials/footer') %>
