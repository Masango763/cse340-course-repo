<%- include('./partials/header') %>
<%
  const orgImages = {
    'CodeCraft Youth Initiative': '/images/org1.jpg',
    'Green Earth Alliance': '/images/placeholder.jpg',
    'HealthAccess Community': '/images/placeholder.jpg',
    'OpenCivic Tech Alliance': '/images/org2.jpg',
    'Senior Digital Bridge': '/images/org3.jpg'
  };
%>
<h2>Partner Organizations</h2>
<% if (organizations && organizations.length > 0) { %>
  <ul style="list-style: none; padding: 0;">
    <% organizations.forEach(org => { %>
      <li style="display: flex; align-items: center; margin-bottom: 15px; background: #f9f9f9; padding: 10px; border-radius: 6px;">
        <img src="<%= orgImages[org.organization_name] || '/images/placeholder.jpg' %>" alt="<%= org.organization_name %>" width="60" height="40" style="object-fit: cover; margin-right: 15px; border-radius: 4px;" onerror="this.src='/images/placeholder.jpg';" />
        <div>
          <a href="/organization/<%= org.organization_id || org.id %>" style="font-size: 1.1em; font-weight: bold; text-decoration: none; color: #0066cc;"><%= org.organization_name %></a>
          <p style="margin: 4px 0 0 0; color: #555; font-size: 0.9em;">Location: <%= org.location %></p>
        </div>
      </li>
    <% }); %>
  </ul>
<% } else { %>
  <p>No organizations found.</p>
<% } %>
<%- include('./partials/footer') %>
