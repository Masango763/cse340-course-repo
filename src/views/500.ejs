<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <main>
    <h1>500 - Server Error</h1>
    <p>Sorry, something went wrong on our end.</p>
    <% if (error && error.message) { %>
      <pre><%= error.message %></pre>
    <% } %>
    <a href="/projects">Return to Projects</a>
  </main>
</body>
</html>
