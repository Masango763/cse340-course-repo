<%- include('partials/header') %>
<h2><%= project.title %></h2>
<p><strong>Description:</strong> <%= project.description %></p>
<p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>
<p><strong>Location:</strong> <%= project.location %></p>
<p><strong>Partner Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>

<% if (categories && categories.length > 0) { %>
  <p><strong>Categories:</strong> 
    <% categories.forEach((cat, index) => { %>
      <a href="/category/<%= cat.category_id %>" class="category-tag"><%= cat.name %></a><%= index < categories.length - 1 ? ', ' : '' %>
    <% }) %>
  </p>
<% } %>

<p><a href="/projects">&larr; Back to Upcoming Projects</a></p>
<%- include('partials/footer') %>
