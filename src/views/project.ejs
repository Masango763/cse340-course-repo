<%- include('./partials/header') %>
<h2><%= project.project_name %></h2>
<p><strong>Date:</strong> <%= new Date(project.project_date).toLocaleDateString() %></p>
<p><strong>Location:</strong> <%= project.location %></p>
<p><strong>Partner Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
<div>
  <h3>Description</h3>
  <p><%= project.project_description %></p>
</div>
<div class="category-tags">
  <h3>Categories</h3>
  <% if (categories && categories.length > 0) { %>
    <ul>
      <% categories.forEach(category => { %>
        <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
      <% }); %>
    </ul>
  <% } else { %>
    <p>No categories assigned.</p>
  <% } %>
</div>
<%- include('./partials/footer') %>
