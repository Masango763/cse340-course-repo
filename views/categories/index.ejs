<%- include('../partials/header') %>
<%- include('../partials/flash') %>
<h2>Service Project Categories</h2>
<p><a href="/new-category">+ Add New Category</a></p>
<% if (categories && categories.length > 0) { %>
  <ul class="row-list">
    <% categories.forEach((cat, index) => {
      const imgNum = index + 1;
      const imgSrc = imgNum <= 4 ? `/images/cat${imgNum}.jpg` : '/images/placeholder.jpg';
    %>
      <li class="row-card">
        <a href="/category/<%= cat.id %>" class="row-card-link">
          <img src="<%= imgSrc %>" alt="<%= cat.name %>" width="60" height="40" class="row-thumb" />
          <div>
            <span class="row-title"><%= cat.name %></span>
          </div>
        </a>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <p>No categories found.</p>
<% } %>
<%- include('../partials/footer') %>
