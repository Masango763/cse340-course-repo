<%- include('../partials/header') %>
<%- include('../partials/flash') %>
<h2><%= category.name %></h2>
<% if (user && user.role_name === 'admin') { %><p><a href="/edit-category/<%= category.id %>">Edit this category</a></p><% } %>

<h3>Projects in this category</h3>
<% if (projects.length > 0) { %>
  <ul class="row-list">
    <% projects.forEach(project => { %>
      <li>
        <h4><a href="/project/<%= project.id %>"><%= project.name %></a></h4>
        <p><strong>Organization:</strong> <%= project.organization_name %></p>
        <p><small>Due: <%= project.due_date ? new Date(project.due_date).toLocaleDateString() : 'N/A' %></small></p>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <p>No projects in this category yet.</p>
<% } %>
<%- include('../partials/footer') %>
