<%- include('../partials/header') %>
<%- include('../partials/flash') %>
<h2>Edit Organization</h2>
<% if (typeof errors !== 'undefined' && errors.length > 0) { %>
  <ul class="form-errors"><% errors.forEach(e => { %><li><%= e.msg %></li><% }) %></ul>
<% } %>
<form method="POST" action="/edit-organization/<%= organization.id %>" class="form">
  <label for="name">Organization Name</label>
  <input type="text" id="name" name="name" value="<%= values.name || '' %>">

  <label for="description">Description</label>
  <textarea id="description" name="description" rows="4"><%= values.description || '' %></textarea>

  <label for="email">Email</label>
  <input type="email" id="email" name="email" value="<%= values.email || '' %>">

  <label for="logo_url">Logo HTTPS Address</label>
  <input type="url" id="logo_url" name="logo_url" placeholder="https://example.com/logo.png" value="<%= values.logo_url || '' %>">

  <button type="submit">Save Changes</button>
</form>
<%- include('../partials/footer') %>
