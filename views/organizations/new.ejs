<%- include('../partials/header') %>
<%- include('../partials/flash') %>
<h2>Add New Organization</h2>
<% if (typeof errors !== 'undefined' && errors.length > 0) { %>
  <ul class="form-errors"><% errors.forEach(e => { %><li><%= e.msg %></li><% }) %></ul>
<% } %>
<form method="POST" action="/new-organization" class="form">
  <label for="name">Organization Name</label>
  <input type="text" id="name" name="name" value="<%= values.name || '' %>" maxlength="100" required>

  <label for="description">Description</label>
  <textarea id="description" name="description" rows="4" required><%= values.description || '' %></textarea>

  <label for="email">Email</label>
  <input type="email" id="email" name="email" value="<%= values.email || '' %>" required>

  <label for="logo_url">Logo HTTPS Address (optional)</label>
  <input type="url" id="logo_url" name="logo_url" placeholder="https://example.com/logo.png" pattern="https://.*" title="Logo address must start with https://" value="<%= values.logo_url || '' %>">

  <button type="submit">Create Organization</button>
</form>
<%- include('../partials/footer') %>
