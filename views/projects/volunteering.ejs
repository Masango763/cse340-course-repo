<main class="content">
    <h1><%= title %></h1>
    <%- messages() %>
    
    <% if (projects && projects.length > 0) { %>
        <ul class="volunteer-list">
            <% projects.forEach(proj => { %>
                <li class="volunteer-item">
                    <a href="/projects/detail/<%= proj.project_id %>"><%= proj.project_name %></a>
                    <form action="/projects/unvolunteer" method="POST" style="display:inline;">
                        <input type="hidden" name="project_id" value="<%= proj.project_id %>">
                        <button type="submit" class="btn-danger">Remove</button>
                    </form>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>You have not signed up to volunteer for any projects yet.</p>
    <% } %>
</main>
