<%- include('../partials/header') %>
<%- include('../partials/flash') %>
<h2>Service Projects</h2>
<p><a href="/new-project">+ Add New Project</a></p>
<%
  const projectImages = {
    'Senior Tech Help Desk': '/images/projects/senior-tech-help-desk.jpg',
    'Youth Code Camp': '/images/projects/youth-code-camp.jpg',
    'Civic Budget Visualizer': '/images/projects/civic-budget-visualizer.jpg',
    'EcoTrack Clean Rivers': '/images/projects/ecotrack-clean-rivers.jpg',
    'Rural Telehealth Kiosk': '/images/projects/rural-telehealth-kiosk.jpg'
  };
%>
<% if (projects && projects.length > 0) { %>
  <ul class="row-list">
    <% projects.forEach(project => { %>
      <li class="row-card">
        <a href="/project/<%= project.id %>" class="row-card-link">
          <img src="<%= projectImages[project.name] || '/images/placeholder.jpg' %>" alt="<%= project.name %>" width="60" height="40" class="row-thumb" />
          <div>
            <span class="row-title"><%= project.name %></span>
            <p class="row-subtitle">
              <%= project.organization_name %>
              &nbsp;|&nbsp; Due: <%= project.due_date ? new Date(project.due_date).toLocaleDateString() : 'N/A' %>
            </p>
          </div>
        </a>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <p>No projects found.</p>
<% } %>
<%- include('../partials/footer') %>
