<%- include('../partials/header') %>
<%- include('../partials/flash') %>
<h2><%= project.name %></h2>
<p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
<p><%= project.description %></p>
<p><small>Due: <%= project.due_date ? new Date(project.due_date).toLocaleDateString() : 'N/A' %></small></p>
<h3>Categories</h3>
<% if (categories.length > 0) { %>
  <ul><% categories.forEach(c => { %><li><%= c.name %></li><% }) %></ul>
<% } else { %><p>No categories assigned.</p><% } %>
<% if (user && user.role_name === 'admin') { %>
  <p><a href="/assign-categories/<%= project.id %>">Update categories</a></p>
  <p><a href="/edit-project/<%= project.id %>">Edit this project</a></p>
<% } %>
<%- include('../partials/footer') %>

<!-- W06 Volunteer Action Section -->
<div class="volunteer-section" style="margin-top: 20px;">
    <% if (locals.loggedin && locals.accountData) { %>
        <% if (locals.isVolunteering) { %>
            <p class="volunteer-active-notice" style="color: green; font-weight: bold;">You are volunteering for this project.</p>
            <form action="/projects/unvolunteer" method="POST">
                <input type="hidden" name="project_id" value="<%= project.project_id %>">
                <button type="submit" class="btn-danger">Remove Volunteer Status</button>
            </form>
        <% } else { %>
            <form action="/projects/volunteer" method="POST">
                <input type="hidden" name="project_id" value="<%= project.project_id %>">
                <button type="submit" class="btn-primary">Volunteer for this Project</button>
            </form>
        <% } %>
    <% } else { %>
        <p><a href="/account/login">Log in</a> to volunteer for this project.</p>
    <% } %>
</div>
